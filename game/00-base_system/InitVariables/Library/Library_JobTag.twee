:: Library-JobTag

/*
  $JobTagLibrary：职业tag定义库。

  每个条目描述一种职业tag在随机生成时提供的内容。

  字段：
    name          显示名
    category      分类："combat"(战斗职业) / "trade"(技艺职业) / "social"(社交职业)

    spellPool     可能携带的法术key数组（生成时从中随机选）
    formationPool 可能携带的法阵key数组
    skillPool     可能携带的技能key数组
    weaponPool    可能携带的武器key数组（生成时从中选一个）
    itemPool      可能携带的道具（数组，每项{id, countMin, countMax, chance}）

    statMod       属性修正（生成后叠加）
                  如 { MagicLevel:10, atk:-3 } 表示魔力等级+10但攻击-3

    spellCount    从spellPool中选几个（{min,max}），缺省{min:1,max:2}
    formationCount 从formationPool中选几个，缺省{min:0,max:1}
    skillCount    从skillPool中选几个，缺省{min:0,max:2}
*/

<<set $JobTagLibrary = {

    /* ===== 战斗职业 ===== */

    "施法者": {
        name: "施法者",
        category: "combat",
        spellPool: ["damage","freeze","heal","meteor","bless","triple","chainsplit","icelock"],
        formationPool: ["DivineProtection","FrostField","GravityBind"],
        skillPool: [],
        weaponPool: ["staff"],
        itemPool: [
            { id:"damageStone", countMin:1, countMax:2, chance:0.3 }
        ],
        statMod: { MagicLevel:10, maxMP:50 },
        spellCount: { min:2, max:4 },
        formationCount: { min:0, max:1 },
        skillCount: { min:0, max:0 }
    },

    "剑士": {
        name: "剑士",
        category: "combat",
        spellPool: [],
        formationPool: [],
        skillPool: ["doubleStrike","sweep","thrust","guard"],
        weaponPool: ["shortSword","greatSword"],
        itemPool: [
            { id:"healPotion", countMin:1, countMax:2, chance:0.5 }
        ],
        statMod: { atk:3, SpeedLevel:5 },
        spellCount: { min:0, max:0 },
        formationCount: { min:0, max:0 },
        skillCount: { min:1, max:3 }
    },

    "弓手": {
