    "治疗师": {
        name: "治疗师",
        category: "combat",
        spellPool: ["heal","bless","revive"],
        formationPool: ["DivineProtection"],
        skillPool: ["firstAid"],
        weaponPool: ["staff"],
        itemPool: [
            { id:"healPotion", countMin:2, countMax:4, chance:0.8 }
        ],
        statMod: { MagicLevel:5, maxMP:30 },
        spellCount: { min:1, max:3 },
