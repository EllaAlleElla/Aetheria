:: Battle [nobr]
<<set $BattleTurnLog = "">>
<<set $ActionLog = "">>
<<takeTurn>>

/* 先检查战斗是否结束(不跳转，只判定) */
<<set _battleOver = false>>
<<set _battleResult = "">>

<<set _playerDead = false>>
<<for _beu = 0; _beu < $Units.length; _beu++>>
  <<if $Units[_beu].isPlayer && $Units[_beu].status === "dead">>
    <<set _playerDead = true>>
  <</if>>
<</for>>
<<set _enemyAlive = false>>
<<set _allyAlive = false>>
<<for _beu = 0; _beu < $Units.length; _beu++>>
  <<if $Units[_beu].status === "active" && not $Units[_beu].isFormation>>
    <<if $Units[_beu].side === "enemy">><<set _enemyAlive = true>>
    <<elseif $Units[_beu].side === "ally">><<set _allyAlive = true>>
    <</if>>
  <</if>>
<</for>>

<<if _playerDead or not _allyAlive>>
  <<set _battleOver = true>>
  <<set _battleResult = "lose">>
<<elseif not _enemyAlive>>
  <<set _battleOver = true>>
  <<set _battleResult = "win">>
<</if>>

<<if _battleOver>>
  /* 战斗结束：先显示最后的行动日志+结果，再让玩家点继续跳转 */
  <div id="EnemyInfo"><<showBattleField>></div>
  <<showGrid>>
  <hr>
  <<if $BattleTurnLog.trim() !== "">>
    <<= $BattleTurnLog.trim().replace(/\n/g,"<br>")>>
    <br>
  <</if>>
  <<if $ActionLog && $ActionLog.trim() !== "">>
    <<= $ActionLog>><br>
  <</if>>
  <hr>
  <<if _battleResult === "win">>
    <strong>战斗胜利！</strong><br>
    <<link "继续">>
      <<set $BattleExitReason = "win">>
      <<settleBattle>>
      <<goto $BattleWin>>
    <</link>>
  <<else>>
    <strong>你倒下了……</strong><br>
    <<link "继续">>
      <<set $BattleExitReason = "lose">>
      <<goto $BattleLose>>
    <</link>>
  <</if>>

<<elseif _turnUnitId === null>>
  战斗陷入僵局。

<<elseif _needPlayerInput>>
  <<set $ActiveActorId = _turnUnitId>>
  <<findUnit $ActiveActorId>>
  <<refreshActionPoints _foundUnit>>
  <<goto "Battle Player Turn">>

<<else>>
  /* AI/法阵行动完毕，展示日志 */
  <div id="EnemyInfo"><<showBattleField>></div>
  <<showGrid>>
  <hr>
  <<if $BattleTurnLog.trim() !== "">>
    <<= $BattleTurnLog.trim().replace(/\n/g,"<br>")>>
  <<elseif $ActionLog && $ActionLog.trim() !== "">>
    <<= $ActionLog>>
  <<else>>
    （无事发生）
  <</if>>
  <hr>
  <<link "继续">>
    <<goto "Battle">>
  <</link>>
<</if>>



:: Battle Player Turn [nobr]
<<findUnit $ActiveActorId>><<set _actor = _foundUnit>>

/* 检查战斗是否已结束(敌人全灭/玩家倒下)，是则跳回Battle展示结果 */
<<set _ptEnemyAlive = false>>
<<for _ptU = 0; _ptU < $Units.length; _ptU++>>
  <<if $Units[_ptU].side === "enemy" && $Units[_ptU].status === "active" && not $Units[_ptU].isFormation>>
    <<set _ptEnemyAlive = true>><<break>>
  <</if>>
<</for>>
<<if not _ptEnemyAlive or not _actor or _actor.status !== "active">>
  /* 战斗实质已结束，跳回Battle让它展示结果 */
  <<if _actor>><<consumeTurn _actor>><</if>>
  <<goto "Battle">>
<</if>>


<div id="EnemyInfo"><<showBattleField>></div>
<<showGrid>>
<hr>

<<if not _actor or _actor.status !== "active">>
  <<tickBuffs _actor>>
  <<consumeTurn _actor>>
  <<goto "Battle">>
<<else>>

  /* 检查是否还有任何可执行的行动，没有则自动结束回合 */
  <<set _canAnything = false>>
  <<if _actor.weapon>>
    <<set _atkSpeedCost = _actor.weapon.speedCost !== undefined ? _actor.weapon.speedCost : 10>>
    <<if _actor.RemainSpeedLevel >= _atkSpeedCost>>
      <<set _enemiesChk = $Units.filter(function(u){ return u.side !== _actor.side && u.status === "active" && !u.isFormation; })>>
      <<if _enemiesChk.length > 0>><<set _canAnything = true>><</if>>
    <</if>>
  <</if>>
  <<if not _canAnything && _actor.RemainMagicLevel > 0>>
    <<for _chkS = 0; _chkS < _actor.spell.length; _chkS++>>
      <<canCast $SpellLibrary[_actor.spell[_chkS]] _actor 1>>
      <<if _canCast>><<set _canAnything = true>><<break>><</if>>
    <</for>>
  <</if>>
  <<if not _canAnything && _actor.items && _actor.items.length > 0>>
    <<for _chkI = 0; _chkI < _actor.items.length; _chkI++>>
      <<canUseItem $ArtificeLibrary[_actor.items[_chkI].id] _actor>>
      <<if _canUse>><<set _canAnything = true>><<break>><</if>>
    <</for>>
  <</if>>
  <<if not _canAnything && _actor.skill && _actor.skill.length > 0>>
    <<for _chkK = 0; _chkK < _actor.skill.length; _chkK++>>
      <<set _chkSk = $SkillLibrary[_actor.skill[_chkK]]>>
      <<if _actor.RemainSpeedLevel >= _chkSk.cost[0].value && (not _chkSk.requireWeapon or _actor.weapon)>>
        <<set _canAnything = true>><<break>>
      <</if>>
    <</for>>
  <</if>>
  <<if not _canAnything && $Field.grid && _actor.pos && _actor.RemainSpeedLevel >= 10>>
    <<for _mvDy2 = -1; _mvDy2 <= 1 && not _canAnything; _mvDy2++>>
      <<for _mvDx2 = -1; _mvDx2 <= 1 && not _canAnything; _mvDx2++>>
        <<if not (_mvDx2 === 0 && _mvDy2 === 0)>>
          <<canMoveTo _actor (_actor.pos.x + _mvDx2) (_actor.pos.y + _mvDy2)>>
          <<if _canMove && _actor.RemainSpeedLevel >= _moveCost>><<set _canAnything = true>><</if>>
        <</if>>
      <</for>>
    <</for>>
  <</if>>


  <<if not _canAnything>>
    <<tickBuffs _actor>>
    <<consumeTurn _actor>>
    <<goto "Battle">>
  <<else>>


    轮到 <<= _actor.name>> 行动。<br>
    行动力：物理 <<= _actor.RemainSpeedLevel>> / 魔力 <<= _actor.RemainMagicLevel>><br>
    <<if $BattleTurnLog.trim() !== "">>
      <hr><<= $BattleTurnLog.trim().replace(/\n/g,"<br>")>><hr>
    <</if>>

    /* ===== 普攻（选格）===== */
    <<if _actor.weapon && _actor.RemainSpeedLevel >= (_actor.weapon.speedCost !== undefined ? _actor.weapon.speedCost : 10)>>
      <<link "普通攻击（选格）">>
        <<goto "Battle Target Cell">>
      <</link>><br>
    <</if>>
    
    /* ===== 剑技列表 ===== */
    <<if _actor.skill && _actor.skill.length > 0>>
      <strong>剑技：</strong><br>
      <<for _puK = 0; _puK < _actor.skill.length; _puK++>>
        <<set _skKey = _actor.skill[_puK]>>
        <<set _skDef = $SkillLibrary[_skKey]>>
        /* 检查SpeedLevel够 */
        <<set _skCost = _skDef.cost[0].value>>
        <<if _actor.RemainSpeedLevel >= _skCost && (not _skDef.requireWeapon or _actor.weapon)>>
          <<capture _skKey, _skDef>>
            <<link _skDef.name>>
              <<set $PendingSkill = _skKey>>
              <<if _skDef.targetMode === "self">>
                /* 自身剑技直接执行 */
                <<performAction `{ actionType:"physical", sourceId:$ActiveActorId, ref:_skKey }`>>
                <<goto "Battle Player Turn">>
              <<else>>
                <<goto "Battle Skill Target Cell">>
              <</if>>
            <</link>>
          <</capture>>
        <<else>>
          <span style="opacity:0.5"><<= _skDef.name>>（无法使用）</span>
        <</if>>
        <br>
      <</for>>
    <</if>>


    /* ===== 法术列表 ===== */
    <<if _actor.RemainMagicLevel > 0 && _actor.spell.length > 0>>
      <strong>法术：</strong><br>
      <<for _puS = 0; _puS < _actor.spell.length; _puS++>>
        <<set _spKey = _actor.spell[_puS]>>
        <<set _sp = $SpellLibrary[_spKey]>>
        <<canCast _sp _actor 1>>
        <<if _canCast>>
          <<capture _spKey, _sp>>
            <<link _sp.name>>
              <<if _sp.defaultTargeting && (_sp.defaultTargeting.side === "ally" || _sp.defaultTargeting.side === "self")>>
                <<set $PendingSpell = _spKey>>
                <<goto "Battle Cast Menu">>
              <<else>>
                <<set $PendingSpell = _spKey>>
                <<goto "Battle Spell Target Cell">>
              <</if>>
            <</link>>
          <</capture>>
        <<else>>
          <span style="opacity:0.5"><<= _sp.name>>（魔力不足）</span>
        <</if>>
        <br>
      <</for>>
    <</if>>

        /* ===== 法阵列表 ===== */
    <<if _actor.RemainMagicLevel > 0 && _actor.formation && _actor.formation.length > 0>>
      <strong>法阵：</strong><br>
      <<for _puF = 0; _puF < _actor.formation.length; _puF++>>
        <<set _fmKey = _actor.formation[_puF]>>
        <<set _fmDef = $FormationLibrary[_fmKey]>>
        <<capture _fmKey, _fmDef>>
          <<link _fmDef.name>>
            <<set $PendingFormation = _fmKey>>
            <<goto "Battle Formation Menu">>
          <</link>>
        <</capture>>
        <br>
      <</for>>
    <</if>>

    
    /* ===== 道具列表 ===== */
    <<if _actor.items && _actor.items.length > 0>>
      <strong>道具：</strong><br>
      <<for _puI = 0; _puI < _actor.items.length; _puI++>>
        <<set _itEntry = _actor.items[_puI]>>
        <<set _itDef = $ArtificeLibrary[_itEntry.id]>>
        <<canUseItem _itDef _actor>>
        <<if _canUse>>
          <<set _itText = _itDef.name + "（×" + _itEntry.count + "）">>
          <<set _itId = _itEntry.id>>
          <<capture _itId, _itText>>
            <<link _itText>>
              <<set $PendingItem = _itId>>
              <<goto "Battle Item Menu">>
            <</link>>
          <</capture>>
        <<else>>
          <span style="opacity:0.5"><<= _itDef.name>>（×<<= _itEntry.count>>，行动力不足）</span>
        <</if>>
        <br>
      <</for>>
    <</if>>

<br>
<br>
    


    /* ===== 移动 ===== */
    <<if $Field.grid && _actor.pos && _actor.RemainSpeedLevel >= 10>>
      <<link "移动">>
        <<goto "Battle Move Target Cell">>
      <</link>><br>
    <</if>>



    <hr>
    <<link "结束回合">>
      <<findUnit $ActiveActorId>><<set _a = _foundUnit>>
      <<tickBuffs _a>>
      <<consumeTurn _a>>
      <<goto "Battle">>
    <</link>>

    <<if $CombatRules && $CombatRules.canFlee === false>>
      <span style="opacity:0.5">逃跑（本场战斗无法逃跑）</span>
    <<else>>
      <<canFlee _actor>>
      <<if _canFlee>>
        <<link "逃跑">>
          <<findUnit $ActiveActorId>><<set _a = _foundUnit>>
          <<tryFlee _a>>
          <<if _fleeFail>>
            <<set $BattleTurnLog = $BattleTurnLog + $ActionLog + "\n">>
            <<tickBuffs _a>>
            <<consumeTurn _a>>
            <<goto "Battle">>
          <</if>>
        <</link>>
      <<else>>
        <span style="opacity:0.5">逃跑（你无路可逃，需先移动到地图边缘）</span>
      <</if>>
      <br>
    <</if>>







  <</if>>

<</if>>



:: Battle Cast Menu [nobr]
<<findUnit $ActiveActorId>><<set _actor = _foundUnit>>
<<set _sp = $SpellLibrary[$PendingSpell]>>

<div id="EnemyInfo"><<showBattleField>></div>
<<showGrid>>
<hr>
<<= _actor.name>> 准备施放 <strong><<= _sp.name>></strong>。<br>

<<set _maxLv = _actor.RemainMagicLevel>>
<<set _mlPerLv = 0>>
<<for _cmI = 0; _cmI < _sp.cost.length; _cmI++>>
  <<if _sp.cost[_cmI].res === "RemainMagicLevel" && _sp.cost[_cmI].scaling === "CastingLevel">>
    <<set _mlPerLv = _sp.cost[_cmI].value>>
  <</if>>
<</for>>
<<if _mlPerLv > 0>>
  <<set _maxLv = Math.floor(_actor.RemainMagicLevel / _mlPerLv)>>
<</if>>
<<if _maxLv < 1>><<set _maxLv = 1>><</if>>

<<set _tg = _sp.defaultTargeting>>

<<if _tg.mode === "chosen">>
  选择目标与施法等级：<br>
  <<set _wantStatus = _tg.status || "active">>
  <<set _cands = $Units.filter(function(u){
    if (u.status !== _wantStatus) return false;
    if (u.isFormation) return false;
    if (_tg.side === "enemy") return u.side !== _actor.side;
    if (_tg.side === "ally") return u.side === _actor.side;
    if (_tg.side === "self") return u.id === _actor.id;
    return true;
  })>>
  <<if $CastLevelChoice === undefined || $CastLevelChoice > _maxLv>><<set $CastLevelChoice = 1>><</if>>
  当前等级：<<= $CastLevelChoice>> / 上限<<= _maxLv>>
  <<link "−">><<if $CastLevelChoice > 1>><<set $CastLevelChoice -= 1>><</if>><<goto "Battle Cast Menu">><</link>>
  <<link "+">><<if $CastLevelChoice < _maxLv>><<set $CastLevelChoice += 1>><</if>><<goto "Battle Cast Menu">><</link>>
  <br><br>
  <<for _cmT = 0; _cmT < _cands.length; _cmT++>>
    <<set _cmName = _cands[_cmT].name>>
    <<set _cmId = _cands[_cmT].id>>
    <<set _cmText = "对 " + _cmName + " 施放">>
    <<capture _cmId, _cmText>>
      <<link _cmText>>
        <<performAction `{ actionType:"spell", sourceId:$ActiveActorId, ref:$PendingSpell, castingLevel:$CastLevelChoice, chosenIds:[_cmId] }`>>
        <<set $CastLevelChoice = 1>>
        <<goto "Battle Player Turn">>
      <</link>>
    <</capture>>
    <br>
  <</for>>

<<else>>
  <<if $CastLevelChoice === undefined || $CastLevelChoice > _maxLv>><<set $CastLevelChoice = 1>><</if>>
  施法等级：<<= $CastLevelChoice>> / 上限<<= _maxLv>>
  <<link "−">><<if $CastLevelChoice > 1>><<set $CastLevelChoice -= 1>><</if>><<goto "Battle Cast Menu">><</link>>
  <<link "+">><<if $CastLevelChoice < _maxLv>><<set $CastLevelChoice += 1>><</if>><<goto "Battle Cast Menu">><</link>>
  <br><br>
  <<set _castText = "施放（" + _sp.name + "）">>
  <<capture _castText>>
    <<link _castText>>
      <<performAction `{ actionType:"spell", sourceId:$ActiveActorId, ref:$PendingSpell, castingLevel:$CastLevelChoice }`>>
      <<set $CastLevelChoice = 1>>
      <<goto "Battle Player Turn">>
    <</link>>
  <</capture>>
  <br>
<</if>>

<hr>
<<link "返回">>
  <<set $CastLevelChoice = 1>>
  <<goto "Battle Player Turn">>
<</link>>


:: Battle Formation Menu [nobr]
<<findUnit $ActiveActorId>><<set _actor = _foundUnit>>
<<set _fm = $FormationLibrary[$PendingFormation]>>

<div id="EnemyInfo"><<showBattleField>></div>
<<showGrid>>
<hr>
<<= _actor.name>> 准备布置法阵 <strong><<= _fm.name>></strong>。<br>

/* 算最大等级：受所有 scaling:CastingLevel 的 cost 项限制 */
<<set _fmMaxLv = 9999>>
<<for _fmI = 0; _fmI < _fm.cost.length; _fmI++>>
  <<set _fmC = _fm.cost[_fmI]>>
  <<if _fmC.scaling === "CastingLevel" && _fmC.value > 0>>
    <<set _fmAvail = _actor[_fmC.res]>>
    <<set _fmCap = Math.floor(_fmAvail / _fmC.value)>>
    <<if _fmCap < _fmMaxLv>><<set _fmMaxLv = _fmCap>><</if>>
  <</if>>
<</for>>
<<if _fmMaxLv < 1>><<set _fmMaxLv = 1>><</if>>

<<if $CastLevelChoice === undefined || $CastLevelChoice > _fmMaxLv>><<set $CastLevelChoice = 1>><</if>>
施法等级：<<= $CastLevelChoice>> / 上限<<= _fmMaxLv>>
（消耗：
<<for _fmI = 0; _fmI < _fm.cost.length; _fmI++>>
  <<set _fmC = _fm.cost[_fmI]>>
  <<= _fmC.res>> <<= _fmC.scaling === "CastingLevel" ? _fmC.value * $CastLevelChoice : _fmC.value>>
  <<if _fmI < _fm.cost.length - 1>>、<</if>>
<</for>>
）<br>
<<link "−">><<if $CastLevelChoice > 1>><<set $CastLevelChoice -= 1>><</if>><<goto "Battle Formation Menu">><</link>>
<<link "+">><<if $CastLevelChoice < _fmMaxLv>><<set $CastLevelChoice += 1>><</if>><<goto "Battle Formation Menu">><</link>>
<br><br>

<<set _fmCastText = "布置（" + _fm.name + "）">>
<<if _fm.targetMode === "area" || _fm.targetMode === "point">>
  <<set _fmSelText = _fmCastText + "→选格">>
  <<capture _fmSelText>>
    <<link _fmSelText>>
      <<goto "Battle Formation Target Cell">>
    <</link>>
  <</capture>>
<<else>>
  <<capture _fmCastText>>
    <<link _fmCastText>>
      <<performAction `{ actionType:"formation", sourceId:$ActiveActorId, ref:$PendingFormation, castingLevel:$CastLevelChoice }`>>
      <<set $CastLevelChoice = 1>>
      <<goto "Battle Player Turn">>
    <</link>>
  <</capture>>
<</if>>
<hr>
<<link "返回">><<set $CastLevelChoice = 1>><<goto "Battle Player Turn">><</link>>


:: Battle Item Menu [nobr]
<<findUnit $ActiveActorId>><<set _actor = _foundUnit>>
<<set _it = $ArtificeLibrary[$PendingItem]>>

<div id="EnemyInfo"><<showBattleField>></div>
<hr>
<<= _actor.name>> 准备使用 <strong><<= _it.name>></strong>。<br>

<<if _it.useType === "drink">>
  /* 喝药对自己，直接用：不选格，显示只读战场图 */
  <<showGrid>>
  <br>
  <<set _imText = "使用（" + _it.name + "）">>
  <<capture _imText>>
    <<link _imText>>
      <<performAction `{ actionType:"item", sourceId:$ActiveActorId, ref:$PendingItem }`>>
      <<goto "Battle Player Turn">>
    <</link>>
  <</capture>>
  <br>
<<else>>
  /* throw/cast/formation：选格。gridTargetUI自带地图，不需要showGrid */
  <<set _itRange = _it.range !== undefined ? _it.range : 999>>
  选择目标格：<br>
  <<gridTargetUI _actor _itRange 0 "item" $PendingItem>>
<</if>>

<hr>
<<link "返回">><<goto "Battle Player Turn">><</link>>




:: Battle Spell Target Cell [nobr]
<<findUnit $ActiveActorId>><<set _actor = _foundUnit>>
<<set _sp = $SpellLibrary[$PendingSpell]>>

<<set _maxLv = _actor.RemainMagicLevel>>
<<set _mlPerLv = 0>>
<<for _cmI = 0; _cmI < _sp.cost.length; _cmI++>>
  <<if _sp.cost[_cmI].res === "RemainMagicLevel" && _sp.cost[_cmI].scaling === "CastingLevel">>
    <<set _mlPerLv = _sp.cost[_cmI].value>>
  <</if>>
<</for>>
<<if _mlPerLv > 0>><<set _maxLv = Math.floor(_actor.RemainMagicLevel / _mlPerLv)>><</if>>
<<if _maxLv < 1>><<set _maxLv = 1>><</if>>
<<if $CastLevelChoice === undefined || $CastLevelChoice > _maxLv>><<set $CastLevelChoice = 1>><</if>>

<<= _actor.name>> 施放 <strong><<= _sp.name>></strong><br>
选择目标格：<br>
<<gridTargetUI _actor 999 0 "spell" $PendingSpell>>
<hr>
施法等级：<span id="lvDisp"><<= $CastLevelChoice>></span> / <<= _maxLv>>
<<link "−">>
  <<if $CastLevelChoice > 1>><<set $CastLevelChoice -= 1>><</if>>
  <<replace "#lvDisp">><<= $CastLevelChoice>><</replace>>
  <<if _sp.aoe>><<aoeRadius $CastLevelChoice>><<replace "#radDisp">><<= _aoeR>><</replace>><</if>>
<</link>>
<<link "+">>
  <<if $CastLevelChoice < _maxLv>><<set $CastLevelChoice += 1>><</if>>
  <<replace "#lvDisp">><<= $CastLevelChoice>><</replace>>
  <<if _sp.aoe>><<aoeRadius $CastLevelChoice>><<replace "#radDisp">><<= _aoeR>><</replace>><</if>>
<</link>>
<<if _sp.aoe>>　范围半径<span id="radDisp"><<aoeRadius $CastLevelChoice>><<= _aoeR>></span><</if>>
<br>
<<link "返回">><<goto "Battle Player Turn">><</link>>


:: Battle Target Cell [nobr]
<<findUnit $ActiveActorId>><<set _actor = _foundUnit>>
<<set _w = _actor.weapon>>
<<set _tcRange = _w && _w.range !== undefined ? _w.range : 1>>
<<set _tcMin = _w && _w.minRange ? _w.minRange : 0>>

<<stat _actor "SpeedLevel">><<set _tcMaxHeavy = Math.floor(_stat / 50)>>
<<if $AttackHeavy === undefined>><<set $AttackHeavy = 0>><</if>>
<<if $AttackHeavy > _tcMaxHeavy>><<set $AttackHeavy = _tcMaxHeavy>><</if>>

<<= _actor.name>> 攻击（射程<<= _tcRange>><<if _tcMin>>，近<<= _tcMin>>格减伤<</if>>）<br>
选择目标格：<br>
<<gridTargetUI _actor _tcRange _tcMin "attack" null>>
<hr>
<<set _tcBaseCost = _w && _w.speedCost !== undefined ? _w.speedCost : 10>>
强度：<span id="heavyDisp"><<if $AttackHeavy === 0>>普通攻击<<else>>重击<<= $AttackHeavy>>级（×<<= 1 + $AttackHeavy>>）<</if>>　消耗<span id="heavyCost"><<= $AttackHeavy === 0 ? _tcBaseCost : _tcBaseCost + 10 * ($AttackHeavy + 1)>></span>
<<if _tcMaxHeavy > 0>>
  <<capture _tcBaseCost, _tcMaxHeavy>>
    <<link "−强度">>
      <<if $AttackHeavy > 0>><<set $AttackHeavy -= 1>><</if>>
      <<replace "#heavyDisp">><<if $AttackHeavy === 0>>普通攻击<<else>>重击<<= $AttackHeavy>>级（×<<= 1 + $AttackHeavy>>）<</if>><</replace>>
      <<replace "#heavyCost">><<= $AttackHeavy === 0 ? _tcBaseCost : _tcBaseCost + 10 * ($AttackHeavy + 1)>><</replace>>
    <</link>>
    <<link "+强度">>
      <<if $AttackHeavy < _tcMaxHeavy>><<set $AttackHeavy += 1>><</if>>
      <<replace "#heavyDisp">><<if $AttackHeavy === 0>>普通攻击<<else>>重击<<= $AttackHeavy>>级（×<<= 1 + $AttackHeavy>>）<</if>><</replace>>
      <<replace "#heavyCost">><<= $AttackHeavy === 0 ? _tcBaseCost : _tcBaseCost + 10 * ($AttackHeavy + 1)>><</replace>>
    <</link>>
  <</capture>>
<</if>>
<br>
<<link "返回">><<set $AttackHeavy = 0>><<goto "Battle Player Turn">><</link>>


:: Battle Skill Target Cell [nobr]
<<findUnit $ActiveActorId>><<set _actor = _foundUnit>>
<<set _sk = $SkillLibrary[$PendingSkill]>>

<<= _actor.name>> 使用 <strong><<= _sk.name>></strong>　消耗<<= _sk.cost[0].value>>SpeedLevel<br>
<<if _sk.aoeRadius !== undefined>>范围半径<<= _sk.aoeRadius>>　<</if>>
<<if _sk.targetMode === "thrust">>（突刺：朝目标方向冲撞，最远<<= _sk.maxDistance>>格）<</if>>
<<if _sk.targetMode === "climb">>（攀爬：无视地势移动到相邻格）<</if>>
<br>选择目标格：<br>
<<set _skRange = _sk.range !== undefined ? _sk.range : (_sk.maxDistance !== undefined ? _sk.maxDistance : 1)>>
<<gridTargetUI _actor _skRange 0 "skill" $PendingSkill>>
<hr>
<<link "返回">><<goto "Battle Player Turn">><</link>>


:: Battle Formation Target Cell [nobr]
<<findUnit $ActiveActorId>><<set _actor = _foundUnit>>
<<set _fm = $FormationLibrary[$PendingFormation]>>

<<set _fmMaxLv = 9999>>
<<for _fmI = 0; _fmI < _fm.cost.length; _fmI++>>
  <<set _fmC = _fm.cost[_fmI]>>
  <<if _fmC.scaling === "CastingLevel" && _fmC.value > 0>>
    <<set _fmAvail = _actor[_fmC.res]>>
    <<set _fmCap = Math.floor(_fmAvail / _fmC.value)>>
    <<if _fmCap < _fmMaxLv>><<set _fmMaxLv = _fmCap>><</if>>
  <</if>>
<</for>>
<<if _fmMaxLv < 1>><<set _fmMaxLv = 1>><</if>>
<<if $CastLevelChoice === undefined || $CastLevelChoice > _fmMaxLv>><<set $CastLevelChoice = 1>><</if>>

<<= _actor.name>> 布置 <strong><<= _fm.name>></strong><br>
选择目标格：<br>
<<gridTargetUI _actor 999 0 "formation" $PendingFormation>>
<hr>
施法等级：<span id="fmLvDisp"><<= $CastLevelChoice>></span> / <<= _fmMaxLv>>
<<capture _fmMaxLv>>
  <<link "−">>
    <<if $CastLevelChoice > 1>><<set $CastLevelChoice -= 1>><</if>>
    <<replace "#fmLvDisp">><<= $CastLevelChoice>><</replace>>
    <<if _fm.aoeBase !== undefined>><<replace "#fmRadDisp">><<= _fm.aoeBase + Math.floor(Math.log($CastLevelChoice)/Math.log(2))>><</replace>><</if>>
  <</link>>
  <<link "+">>
    <<if $CastLevelChoice < _fmMaxLv>><<set $CastLevelChoice += 1>><</if>>
    <<replace "#fmLvDisp">><<= $CastLevelChoice>><</replace>>
    <<if _fm.aoeBase !== undefined>><<replace "#fmRadDisp">><<= _fm.aoeBase + Math.floor(Math.log($CastLevelChoice)/Math.log(2))>><</replace>><</if>>
  <</link>>
<</capture>>
<<if _fm.aoeBase !== undefined>>　半径<span id="fmRadDisp"><<= _fm.aoeBase + Math.floor(Math.log($CastLevelChoice)/Math.log(2))>></span><</if>>
<br>
<<link "返回">><<set $CastLevelChoice = 1>><<goto "Battle Player Turn">><</link>>


:: Battle Move Target Cell [nobr]
<<findUnit $ActiveActorId>><<set _actor = _foundUnit>>

<div id="EnemyInfo"><<showBattleField>></div>
<hr>
<<= _actor.name>> 移动（当前 <<= _actor.pos.x>>,<<= _actor.pos.y>>，剩余SpeedLevel <<= _actor.RemainSpeedLevel>>）<br>
选择移动目标格（黄边可移动）：<br>
<<gridTargetUI _actor 1 0 "move" null>>
<hr>
<<link "返回">><<goto "Battle Player Turn">><</link>>
